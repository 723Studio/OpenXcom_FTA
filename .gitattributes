# Set stable line endings for the engine tree.
* text=auto
.gitattributes text eol=lf

# Source and project metadata.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.in text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Visual Studio and Windows resource/project files.
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.rc text eol=crlf

# Binary files.
*.png binary
*.gif binary
*.ico binary
*.bmp binary
*.jpg binary
*.jpeg binary
*.ogg binary
*.wav binary
*.mp3 binary
*.mid binary
*.exe binary
*.dll binary
*.lib binary
*.pdb binary
